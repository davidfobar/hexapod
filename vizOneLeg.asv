clear; clc;

a1 = 135; a2 = 40; a3 = 80; a4 = 125;
t1 = pi/6;
linkParams = {t1, a1, a2, a3, a4};

jLim = [-pi/2  pi/2;
        -pi/2  pi/2;
         0.0   1.0;
        -pi/2  pi/2;
        -pi/2  pi/2;
        -pi/2  pi/2;];

theta_i = [t1, -pi/4,  -pi/3, -5*5/6];
theta_f = [t1,  pi/4, 2*pi/3,  pi/10];

ti = 0.0;
tf = 2.0;
Ti = Solve_FK(linkParams, theta_i);
Tf = Solve_FK(linkParams, theta_f);

nTimeSteps = 60;
tEvalList = linspace(t0, tf, nTimeSteps);
