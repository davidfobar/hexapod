function generateVideo(t, linkParams,  title_text, filename)
    nTimeSteps = size(t, 1);

    % generate a 3d plot that shows the motion of the arm, also saved as
    % animation
    f2 = figure('Position', [200 200 1200 800], 'Color','w'); 
    ax = axes('Parent',f2);
    hold(ax, 'on');
    grid(ax, 'on');
    ax.Color  = 'w';  
    ax.XColor = 'k';   
    ax.YColor = 'k';
    ax.ZColor = 'k';

    view(3);
    axis([-5,5, -5,5, -5,5]);
    xlabel('x', Color='k'); ylabel('y', Color='k'); zlabel('z', Color='k');
    title(sprintf('End-Effector Cartesian Path with Orientation for %s', title_text), Color='k');

    v = VideoWriter(sprintf('./%s_arm.avi', filename),'Motion JPEG AVI');
    open(v);
   
    for i=1:nTimeSteps
        
        jointLocations = Solve_JointPositions(linkParams, t);

        j1 = jointLocations(:,1);
        j2 = jointLocations(:,2);
        

        % determine the first joint location
        a1 = 1;
        a2 = .5;
        
        p0 = [0;0;0];
        p1 = p0 + a1*[cos(t(i,1)); sin(t(i,1)); 0];
        p2 = p1 + a2*[cos(t(i,1)+t(i,2)); sin(t(i,1)+t(i,2)); 0];
        p3 = p2 + [0;0;t(i,3)];

        T = Solve_FK(linkParams, t(i,:));
        R = T(1:3,1:3);
        L = [p0 p1 p2 p3]';
        
        hold on;
        plot3(L(:,1),L(:,2),L(:,3),'Color','k','LineWidth',2);
        %quiver3(ones(3,1)*p3(1),ones(3,1)*p3(2),ones(3,1)*p3(3),R(1,:)',R(2,:)',R(3,:)',.5,'b');
        % update each axis quiver
        quiver3(ax, p3(1), p3(2), p3(3), R(1,1), R(2,1), R(3,1), 0.5, 'r', 'LineWidth', 1.5); % X axis
        quiver3(ax, p3(1), p3(2), p3(3), R(1,2), R(2,2), R(3,2), 0.5, 'g', 'LineWidth', 1.5); % Y axis
        quiver3(ax, p3(1), p3(2), p3(3), R(1,3), R(2,3), R(3,3), 0.5, 'b', 'LineWidth', 1.5); % Z axis


        hold off;

        frame = getframe(f2);
        writeVideo(v,frame);

        pause(1/30);
        ax = gca;
        cla(ax);
    end
    close(v);

end